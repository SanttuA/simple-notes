{
  "name": "simple-notes",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node ./scripts/expo-no-telemetry.js start",
    "android": "node ./scripts/expo-no-telemetry.js start --android",
    "ios": "node ./scripts/expo-no-telemetry.js start --ios",
    "web": "node ./scripts/expo-no-telemetry.js start --web",
    "lint": "node ./scripts/expo-no-telemetry.js lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --runInBand",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/elements": "^2.9.18",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.25",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.7",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.14",
    "expo-router": "~55.0.15",
    "expo-splash-screen": "~55.0.21",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.15",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.18",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.2.6",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "postcss": "8.5.10"
  },
  "private": true
}
